#所有节点都需安装
[jdk]
myapp-01
myapp-02
myapp-03

#须配置为单数节点
[zookeeper]
myapp-01 myid=1
myapp-02 myid=2
myapp-03 myid=3

#所有目录配置项均不能位于根目录，且目录结尾不加/，下同
[zookeeper:vars]
zk_install_dir=/opt/bigdata/zookeeper
zk_package_name=apache-zookeeper-3.7.0-bin.tar.gz
zk_dir_name=apache-zookeeper-3.7.0-bin
zk_new_dir_name=zookeeper-3.7.0

[hadoop]
myapp-01
myapp-02
myapp-03

[hadoop:vars]
hadoop_package_name=hadoop-3.2.2.tar.gz
hadoop_dir_name=hadoop-3.2.2
nn_server=["myapp-01", "myapp-02"]
rm_server=["myapp-01", "myapp-03"]
hadoop_super_user=myapp
#hadoop数据路径，需保证磁盘容量充足
hadoop_data_dir=/var/lib/hadoop/metadata
#hdfs数据路径，建议以磁盘的形式进行挂载，数据存放在各个路径下的hdfs/data路径
hadoop_datanode_data_dir=["/var/lib/hadoop/data1", "/var/lib/hadoop/data2"]
hadoop_datanode_data_dir1="/var/lib/hadoop/data1"
hadoop_datanode_data_dir2="/var/lib/hadoop/data2"


[hive]
myapp-02

[hive:vars]
hive_package_name=apache-hive-3.1.0-bin.tar.gz
hive_dir_name=apache-hive-3.1.0-bin
hive_new_dir_name=hive-3.1.0
hive_install_dir=/opt/bigdata/hive
hiveserver2_proxy_user=myapp
##pg数据库信息
pg_server=postgres.example.local
pg_port=5432
pg_user=hive
pg_password=your_password_here


#所有节点都需安装，server必须配置在第一行，其余节点配置成client
[kerberos]
myapp-03 role=server
myapp-01 role=client
myapp-02 role=client


[all:vars]
##运行hadoop相关程序的用户
user=myapp
usergroup=myapp
##hadoop安装目录
hadoop_install_dir=/opt/bigdata/hadoop
tmp_dir=/tmp
##配置hadoop.security.authentication参数,是否开启kerberos：
##True/False
## ARM 环境暂时不要设置为 True
kerberos_auth=False
##java安装路径
jdk_install_dir=/opt/bigdata/java
java_package_name=jdk-8u321-linux-x64.tar.gz
java_dir_name=jdk1.8.0_321

##===========================================
## 可自定义变量 (以下变量可根据实际需求修改)
##===========================================

## Kerberos 配置
kerberos_realm=EXAMPLE.COM
kerberos_domain=example.com
kerberos_user=myapp
kerberos_user_password=changeme
kerberos_secondary_user=myuser
kerberos_secondary_user_password=changeme

## HDFS/YARN 集群标识
hdfs_cluster_id=myapp-hdfs
yarn_cluster_id=myapp-yarn

## LDAP 配置
ldap_dc=example
ldap_password=changeme123

## SSL 证书信息
cert_org=example
cert_locality=city
cert_state=state
cert_country=cn
cert_ou=mobile

